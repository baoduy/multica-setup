  "cards": [
    {
      "dot": "rose",
      "title": "Branch rules",
      "items": [
        "No feature branch: steward commits straight onto dev by refspec",
        "Never a bare git push; no agent merges main, only the owner",
        "Never force-push dev; only the live/drunk tag is force-moved"
      ]
    },
    {
      "dot": "cyan",
      "title": "Tag contract",
      "items": [
        "live/drunk marks the main commit that matches the live workspace",
        "Next sync diffs live/drunk..origin/main, so skipped commits still sync",
        "Tag stays put on any failure; the next run retries the same range"
      ]
    }
  ]
